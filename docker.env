# Docker Environment Configuration
DATABASE_URL=postgresql+psycopg://postgres:root123@db:5432/postgres
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_NAME=Fitness Journal System Backend

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000

# RabbitMQ Configuration
RABBITMQ_URL=amqp://fitbuddy:fitbuddy123@rabbitmq:5672/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=fitbuddy
RABBITMQ_PASSWORD=fitbuddy123

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Cerebras AI Provider
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_TIMEOUT_SECONDS=45